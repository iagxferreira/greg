# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=geo_resolution
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Nominatim geocoding fallback (used when the RAG pipeline has no confident match).
# Defaults hit the public instance — fine for local dev, but set NOMINATIM_USER_AGENT
# to something identifying your app/contact per Nominatim's usage policy if you expect
# real traffic: https://operations.osmfoundation.org/policies/nominatim/
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=geo-resolution-rag/0.1
